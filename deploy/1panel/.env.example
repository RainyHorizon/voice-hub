# Copy this file to .env inside the 1Panel Compose project directory.
# Never upload the completed .env file to GitHub or paste its secrets into chat.
VOICE_STUDIO_VERSION=1.7.0
VOICE_STUDIO_HOST_PORT=8765
VOICE_STUDIO_GATEWAY_KEY=replace-with-a-long-random-gateway-key

# Fill only the providers you use.
VOICE_STUDIO_DASHSCOPE_API_KEY=
VOICE_STUDIO_VOLCENGINE_API_KEY=
VOICE_STUDIO_VOLCENGINE_OPENAPI_ACCESS_KEY=
VOICE_STUDIO_VOLCENGINE_OPENAPI_SECRET_KEY=
VOICE_STUDIO_VOLCENGINE_PROJECT_NAME=
VOICE_STUDIO_MINIMAX_API_KEY=
VOICE_STUDIO_MIMO_API_KEY=

VOICE_STUDIO_MAX_CONCURRENT_SYNTHESIS=4
VOICE_STUDIO_MCP_ENABLED=true
VOICE_STUDIO_MCP_MAX_AUDIO_BYTES=15728640
VOICE_STUDIO_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
